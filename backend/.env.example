# Copy to .env (never commit .env). Placeholders only.
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

# Neon/Postgres example: postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_S=8
OSRM_CACHE_TTL_S=300

CLASSICAL_TIME_LIMIT_S=5
QUANTUM_MAX_STOPS=4
QUANTUM_TIMEOUT_S=60
