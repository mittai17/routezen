# API base URL for the RouteZen backend (FastAPI, /api/v1 prefix).
#
# - Android emulator (AVD): the emulator's "localhost" is itself, not your dev machine.
#   Use 10.0.2.2, which the emulator maps to the host's localhost. The client falls back
#   to this automatically on Android if the variable is unset, but set it explicitly for clarity.
# - Physical device (Expo Go / dev client over Wi-Fi): use your dev machine's LAN IP, e.g.
#   http://192.168.1.23:8000/api/v1 — "localhost" on a physical device means the device itself.
# - iOS simulator: localhost works as-is.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
